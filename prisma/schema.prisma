datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Gift {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  purchaseUrl String
  isReserved  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
} 